    {
      "id": 17,
      "type": "stat",
      "title": "Days to 20% SSD life",
      "description": "Linear projection from the last 30 days of remaining life. Capped at 10 years; empty when life did not drop in that window.",
      "datasource": {
        "type": "prometheus",
        "uid": "cdup605h5snpce"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cdup605h5snpce"
          },
          "expr": "clamp_max((diskRemainLife{diskID=~\"Cache.*\"} - 20) / -deriv(diskRemainLife{diskID=~\"Cache.*\"}[30d]) / 86400 > 0, 3650)",
          "legendFormat": "{{diskID}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
